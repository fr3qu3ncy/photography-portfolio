<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - <%= album.title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <nav class="admin-nav">
    <a href="/admin" class="admin-logo"><%= siteName %> <span class="admin-badge">Admin</span></a>
    <div class="admin-nav-links">
      <a href="/admin">Albums</a>
      <a href="/admin/settings">Settings</a>
      <a href="/" target="_blank">View Site</a>
      <a href="/admin/logout">Logout</a>
    </div>
  </nav>
  <main class="admin-container">
    <div class="admin-album-header">
      <a href="/admin" class="back-link">&larr; Back to Albums</a>
      <h1 class="admin-title"><%= album.title %></h1>
    </div>

    <!-- Album Details Form -->
    <form method="POST" action="/admin/album/<%= album.id %>/update" class="admin-form">
      <div class="form-row">
        <div class="form-group">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" value="<%= album.title %>" required>
        </div>
        <div class="form-group">
          <label for="subtitle">Subtitle</label>
          <input type="text" id="subtitle" name="subtitle" value="<%= album.subtitle || '' %>">
        </div>
        <div class="form-group">
          <label for="date">Date</label>
          <input type="date" id="date" name="date" value="<%= album.date %>">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </form>

    <!-- Photo Upload -->
    <div class="upload-section">
      <h2>Photos (<%= (album.photos || []).length %>)</h2>
      <form method="POST" action="/admin/album/<%= album.id %>/photos" enctype="multipart/form-data" id="uploadForm">
        <div class="drop-zone" id="dropZone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <p>Drop photos here or click to browse</p>
          <p class="upload-hint">JPG, PNG, WebP &middot; Max 20MB per file</p>
          <input type="file" name="photos" multiple accept="image/*" id="fileInput" class="file-input">
        </div>
        <button type="submit" class="btn btn-primary upload-btn" id="uploadBtn" style="display:none">
          Upload <span id="fileCount"></span>
        </button>
      </form>
    </div>

    <!-- Bulk Actions Toolbar (top) -->
    <div class="bulk-toolbar">
      <label class="select-all-label">
        <input type="checkbox" class="select-all bulk-checkbox">
        <span>Select All</span>
      </label>
      <span class="selection-count">0 selected</span>
      <form method="POST" action="/admin/album/<%= album.id %>/photos/bulk-delete"
            class="bulk-delete-form"
            onsubmit="return confirmBulkDelete()">
        <button type="submit" class="bulk-delete-btn" disabled>
          Delete Selected
        </button>
      </form>
    </div>

    <!-- Photos Grid -->
    <form id="photosForm">
    <div class="admin-photos-grid">
      <% (album.photos || []).forEach(photo => { %>
        <div class="admin-photo-item">
          <label class="photo-checkbox">
            <input type="checkbox" name="photoId" value="<%= photo.id %>" class="photo-select"
                   onchange="updateBulkState()">
            <span class="checkmark"></span>
          </label>
          <img src="/uploads/<%= photo.thumbFilename %>" alt="">
          <div class="admin-photo-actions">
            <% if (album.titlePhotoId === photo.id) { %>
              <span class="title-badge">Title Photo</span>
            <% } else { %>
              <form method="POST" action="/admin/album/<%= album.id %>/photo/<%= photo.id %>/title" class="inline-form">
                <button type="submit" class="btn btn-xs btn-outline" title="Set as title photo">&#9733;</button>
              </form>
            <% } %>\
            <form method="POST" action="/admin/album/<%= album.id %>/photo/<%= photo.id %>/delete" class="inline-form"
                  onsubmit="return confirm('Delete this photo?')">
              <button type="submit" class="btn btn-xs btn-danger" title="Delete photo">&times;</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    </form>

    <!-- Bulk Actions Toolbar (bottom) -->
    <div class="bulk-toolbar bulk-toolbar-bottom">
      <label class="select-all-label">
        <input type="checkbox" class="select-all bulk-checkbox">
        <span>Select All</span>
      </label>
      <span class="selection-count">0 selected</span>
      <form method="POST" action="/admin/album/<%= album.id %>/photos/bulk-delete"
            class="bulk-delete-form"
            onsubmit="return confirmBulkDelete()">
        <button type="submit" class="bulk-delete-btn" disabled>
          Delete Selected
        </button>
      </form>
    </div>

    <!-- Delete Album -->
    <div class="danger-zone">
      <h3>Delete Album</h3>
      <p>This will permanently delete this album and all its photos.</p>
      <form method="POST" action="/admin/album/<%= album.id %>/delete"
            onsubmit="return confirm('Are you sure? This cannot be undone.')">
        <button type="submit" class="btn btn-danger">Delete Album</button>
      </form>
    </div>
  </main>

  <script src="/js/upload.js"></script>
  <script>
    function updateBulkState() {
      const checkboxes = document.querySelectorAll('.photo-select');
      const selected = Array.from(checkboxes).filter(cb => cb.checked);
      const count = selected.length;

      // Sync all select-all checkboxes
      document.querySelectorAll('.select-all').forEach(sa => {
        sa.checked = count === checkboxes.length && checkboxes.length > 0;
        sa.indeterminate = count > 0 && count < checkboxes.length;
      });

      // Sync all selection counts
      document.querySelectorAll('.selection-count').forEach(el => {
        el.textContent = count + ' selected';
      });

      // Sync all delete buttons
      document.querySelectorAll('.bulk-delete-btn').forEach(btn => {
        btn.disabled = count === 0;
      });
    }

    // Wire up all select-all checkboxes
    document.querySelectorAll('.select-all').forEach(sa => {
      sa.addEventListener('change', function() {
        document.querySelectorAll('.photo-select').forEach(cb => cb.checked = this.checked);
        updateBulkState();
      });
    });

    // Wire up all bulk delete forms
    document.querySelectorAll('.bulk-delete-form').forEach(form => {
      form.addEventListener('submit', function() {
        const selected = document.querySelectorAll('.photo-select:checked');
        this.querySelectorAll('input[name="photoIds"]').forEach(el => el.remove());
        selected.forEach(cb => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'photoIds';
          input.value = cb.value;
          this.appendChild(input);
        });
      });
    });

    function confirmBulkDelete() {
      const selected = document.querySelectorAll('.photo-select:checked').length;
      return confirm('Delete ' + selected + ' photo' + (selected > 1 ? 's' : '') + '?');
    }
  </script>
</body>
</html>
