<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Settings - <%= siteName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <nav class="admin-nav">
    <a href="/admin" class="admin-logo"><%= siteName %> <span class="admin-badge">Admin</span></a>
    <div class="admin-nav-links">
      <a href="/admin">Albums</a>
      <a href="/admin/settings">Settings</a>
      <a href="/" target="_blank">View Site</a>
      <a href="/admin/logout">Logout</a>
    </div>
  </nav>
  <main class="admin-container">
    <h1 class="admin-title">Site Settings</h1>

    <form method="POST" action="/admin/settings" class="admin-form">
      <div class="form-group">
        <label for="siteName">Site Name</label>
        <input type="text" id="siteName" name="siteName" value="<%= currentName %>" required>
      </div>
      <button type="submit" class="btn btn-primary">Save</button>
    </form>

    <div class="logo-section">
      <h2>Site Logo</h2>
      <form method="POST" action="/admin/settings/logo" enctype="multipart/form-data" class="admin-form">
        <div class="form-group">
          <label for="logo">Upload new logo</label>
          <input type="file" id="logo" name="logo" accept="image/*">
        </div>
        <button type="submit" class="btn btn-primary">Upload Logo</button>
      </form>
      <form method="POST" action="/admin/settings" class="admin-form">
        <input type="hidden" name="removeLogo" value="true">
        <input type="hidden" name="siteName" value="<%= currentName %>">
        <% if (hasLogo) { %>
          <button type="submit" class="btn btn-danger">Remove Logo</button>
        <% } %>
      </form>
    </div>
  </main>
</body>
</html>
