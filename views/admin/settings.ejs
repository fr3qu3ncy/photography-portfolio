<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - <%= siteName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@600;700&family=DM+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Space+Grotesk:wght@400;600;700&family=Lora:wght@400;600;700&family=Montserrat:wght@400;600;700&family=Merriweather:wght@400;700&family=Roboto+Slab:wght@400;600;700&family=Work+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    .typeface-preview {
      margin-top: 1rem;
      padding: 1.25rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .typeface-preview-heading {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }
    .typeface-preview-body {
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--text-muted);
    }
    .typeface-preview-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.25rem;
    }

    /* ── Theme Preview ── */
    .theme-preview-container {
      margin-top: 1rem;
      margin-bottom: 1rem;
    }
    .theme-preview-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }
    .theme-preview {
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--border);
      transition: all 0.3s;
    }
    .theme-preview-dark {
      --tp-bg: #0a0a0a;
      --tp-bg-elevated: #141414;
      --tp-bg-card: #1a1a1a;
      --tp-text: #f0f0f0;
      --tp-text-muted: #888;
      --tp-accent: #6d5dfc;
      --tp-border: #2a2a2a;
    }
    .theme-preview-light {
      --tp-bg: #fafaf9;
      --tp-bg-elevated: #ffffff;
      --tp-bg-card: #ffffff;
      --tp-text: #1c1917;
      --tp-text-muted: #78716c;
      --tp-accent: #6366f1;
      --tp-border: #e7e5e4;
    }
    .tp-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.5rem 0.75rem;
      background: var(--tp-bg-elevated);
      border-bottom: 1px solid var(--tp-border);
    }
    .tp-logo {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--tp-text);
    }
    .tp-nav-links {
      display: flex;
      gap: 0.5rem;
    }
    .tp-nav-link {
      font-size: 0.5rem;
      color: var(--tp-text-muted);
    }
    .tp-hero {
      padding: 1.5rem 0.75rem 0.75rem;
      background: var(--tp-bg);
      text-align: center;
    }
    .tp-hero-heading {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--tp-text);
      margin-bottom: 0.125rem;
    }
    .tp-hero-sub {
      font-size: 0.5625rem;
      color: var(--tp-text-muted);
      margin-bottom: 0.125rem;
    }
    .tp-hero-desc {
      font-size: 0.5rem;
      color: var(--tp-text-muted);
      line-height: 1.5;
      margin-bottom: 0.75rem;
    }
    .tp-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.375rem;
      padding: 0 0.75rem 0.75rem;
      background: var(--tp-bg);
    }
    .tp-card {
      background: var(--tp-bg-card);
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--tp-border);
    }
    .tp-card-img {
      width: 100%;
      aspect-ratio: 4/3;
      background: var(--tp-bg-elevated);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .tp-card-img svg {
      width: 16px;
      height: 16px;
      color: var(--tp-text-muted);
      opacity: 0.3;
    }
    .tp-card-info {
      padding: 0.375rem;
    }
    .tp-card-title {
      font-size: 0.5625rem;
      font-weight: 600;
      color: var(--tp-text);
      margin-bottom: 0.125rem;
    }
    .tp-card-date {
      font-size: 0.4375rem;
      color: var(--tp-text-muted);
    }
  </style>
</head>
<body class="admin-body">
  <nav class="admin-nav">
    <a href="/admin" class="admin-logo"><%= siteName %> <span class="admin-badge">Admin</span></a>
    <div class="admin-nav-links">
      <a href="/admin">Albums</a>
      <a href="/admin/settings">Settings</a>
      <a href="/" target="_blank">View Site</a>
      <a href="/admin/logout">Logout</a>
    </div>
  </nav>
  <main class="admin-container">
    <h1 class="admin-title">Settings</h1>

    <form class="admin-form" action="/admin/settings" method="post">
      <div class="form-group">
        <label>Site Name</label>
        <input type="text" name="siteName" value="<%= currentName %>" required>
      </div>

      <div class="form-group">
        <label>Page Heading</label>
        <input type="text" name="heading" id="headingInput" value="<%= currentHeading %>" required>
      </div>

      <div class="form-group">
        <label>Subheading</label>
        <input type="text" name="subheading" id="subheadingInput" value="<%= currentSubheading %>">
      </div>

      <div class="form-group">
        <label>Description</label>
        <textarea name="description" id="descriptionInput" rows="3" style="resize:vertical;"><%= currentDescription %></textarea>
      </div>

      <div class="form-group">
        <label>Heading Alignment</label>
        <select id="alignmentSelect" name="headingAlignment" style="width:100%;padding:0.625rem 0.75rem;background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);font-size:0.875rem;">
          <option value="left"<%= currentHeadingAlignment === 'left' ? ' selected' : '' %>>Left</option>
          <option value="center"<%= currentHeadingAlignment === 'center' ? ' selected' : '' %>>Center</option>
          <option value="right"<%= currentHeadingAlignment === 'right' ? ' selected' : '' %>>Right</option>
        </select>
      </div>

      <div class="form-group">
        <label>Theme</label>
        <select id="themeSelect" name="theme" style="width:100%;padding:0.625rem 0.75rem;background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);font-size:0.875rem;">
          <option value="dark"<%= currentTheme === 'dark' ? ' selected' : '' %>>Dark</option>
          <option value="light"<%= currentTheme === 'light' ? ' selected' : '' %>>Light</option>
        </select>
      </div>

      <div class="theme-preview-container">
        <div class="theme-preview-label">Theme Preview</div>
        <div id="themePreview" class="theme-preview theme-preview-dark">
          <div class="tp-nav">
            <span class="tp-logo" id="tpLogo"><%= currentName || 'Lens' %></span>
            <div class="tp-nav-links">
              <span class="tp-nav-link" id="tpNavLinks">Albums</span>
              <span class="tp-nav-link">About</span>
            </div>
          </div>
          <div class="tp-hero" id="tpHero">
            <div class="tp-hero-heading" id="tpHeroHeading"><%= currentHeading || 'Albums' %></div>
            <div class="tp-hero-sub" id="tpHeroSub"><%= currentSubheading || '' %></div>
            <div class="tp-hero-desc" id="tpHeroDesc"><%= currentDescription || '' %></div>
          </div>
          <div class="tp-grid">
            <div class="tp-card">
              <div class="tp-card-img"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
              <div class="tp-card-info">
                <div class="tp-card-title" id="tpCardTitle1">Album One</div>
                <div class="tp-card-date" id="tpCardDate1">June 2026</div>
              </div>
            </div>
            <div class="tp-card">
              <div class="tp-card-img"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
              <div class="tp-card-info">
                <div class="tp-card-title">Album Two</div>
                <div class="tp-card-date">May 2026</div>
              </div>
            </div>
            <div class="tp-card">
              <div class="tp-card-img"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
              <div class="tp-card-info">
                <div class="tp-card-title">Album Three</div>
                <div class="tp-card-date">April 2026</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="typefacePreview" class="typeface-preview">
        <div class="typeface-preview-label">Heading Preview</div>
        <div class="typeface-preview-heading" id="previewHeading">The quick brown fox</div>
        <div class="typeface-preview-label" style="margin-top:0.75rem;">Body Text Preview</div>
        <div class="typeface-preview-body" id="previewBody">A photography portfolio showcasing moments captured with intention — from quiet landscapes to vibrant cityscapes.</div>
      </div>

      <div class="form-group" style="margin-top:1rem;">
        <label>Typeface</label>
        <select id="typefaceSelect" name="typeface" style="width:100%;padding:0.625rem 0.75rem;background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);font-size:0.875rem;">
          <option value="system"<%= currentTypeface === 'system' ? ' selected' : '' %> style="font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif;">System Sans (default)</option>
          <option value="inter"<%= currentTypeface === 'inter' ? ' selected' : '' %> style="font-family: 'Inter', sans-serif;">Inter</option>
          <option value="playfair"<%= currentTypeface === 'playfair' ? ' selected' : '' %> style="font-family: 'Playfair Display', serif;">Playfair Display</option>
          <option value="dmsans"<%= currentTypeface === 'dmsans' ? ' selected' : '' %> style="font-family: 'DM Sans', sans-serif;">DM Sans</option>
          <option value="spacegrotesk"<%= currentTypeface === 'spacegrotesk' ? ' selected' : '' %> style="font-family: 'Space Grotesk', sans-serif;">Space Grotesk</option>
          <option value="lora"<%= currentTypeface === 'lora' ? ' selected' : '' %> style="font-family: 'Lora', serif;">Lora</option>
          <option value="montserrat"<%= currentTypeface === 'montserrat' ? ' selected' : '' %> style="font-family: 'Montserrat', sans-serif;">Montserrat</option>
          <option value="merriweather"<%= currentTypeface === 'merriweather' ? ' selected' : '' %> style="font-family: 'Merriweather', serif;">Merriweather</option>
          <option value="roboto_slab"<%= currentTypeface === 'roboto_slab' ? ' selected' : '' %> style="font-family: 'Roboto Slab', serif;">Roboto Slab</option>
          <option value="worksans"<%= currentTypeface === 'worksans' ? ' selected' : '' %> style="font-family: 'Work Sans', sans-serif;">Work Sans</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary">Save Settings</button>
    </form>

    <div style="margin-top:2rem;">
      <h2 style="font-size:1.25rem;margin-bottom:1rem;">Logo</h2>
      <form class="admin-form" action="/admin/upload-logo" method="post" enctype="multipart/form-data">
        <% if (hasLogo) { %>
          <div style="margin-bottom:1rem;">
            <img src="/uploads/<%= logo %>" alt="Current logo" style="max-height:64px;border-radius:var(--radius);border:1px solid var(--border);">
          </div>
        <% } %>
        <div class="form-group">
          <label>Upload Logo (PNG, JPG, SVG)</label>
          <input type="file" name="logo" accept="image/*">
        </div>
        <button type="submit" class="btn btn-outline">Upload Logo</button>
      </form>

      <% if (hasLogo) { %>
        <form action="/admin/settings" method="post" style="margin-top:1rem;">
          <input type="hidden" name="removeLogo" value="true">
          <button type="submit" class="btn btn-danger btn-sm">Remove Logo</button>
        </form>
      <% } %>
    </div>
  </main>

  <script>
    /* ── Theme Preview ── */
    const themeSelect = document.getElementById('themeSelect');
    const themePreview = document.getElementById('themePreview');

    function updateThemePreview() {
      themePreview.classList.remove('theme-preview-dark', 'theme-preview-light');
      themePreview.classList.add('theme-preview-' + themeSelect.value);
    }

    themeSelect.addEventListener('change', updateThemePreview);
    updateThemePreview();

    /* ── Heading/Subheading/Description/Alignment Preview ── */
    const headingInput = document.getElementById('headingInput');
    const subheadingInput = document.getElementById('subheadingInput');
    const descriptionInput = document.getElementById('descriptionInput');
    const alignmentSelect = document.getElementById('alignmentSelect');
    const tpHero = document.getElementById('tpHero');
    const tpHeroHeading = document.getElementById('tpHeroHeading');
    const tpHeroSub = document.getElementById('tpHeroSub');
    const tpHeroDesc = document.getElementById('tpHeroDesc');

    function updateHeroPreview() {
      const heading = headingInput.value || 'Albums';
      const subheading = subheadingInput.value || '';
      const description = descriptionInput.value || '';
      const alignment = alignmentSelect.value || 'center';
      tpHeroHeading.textContent = heading;
      tpHeroSub.textContent = subheading;
      tpHeroSub.style.display = subheading ? '' : 'none';
      tpHeroDesc.textContent = description;
      tpHeroDesc.style.display = description ? '' : 'none';
      tpHero.style.textAlign = alignment;
    }

    headingInput.addEventListener('input', updateHeroPreview);
    subheadingInput.addEventListener('input', updateHeroPreview);
    descriptionInput.addEventListener('input', updateHeroPreview);
    alignmentSelect.addEventListener('change', updateHeroPreview);
    updateHeroPreview();

    /* ── Typeface Preview ── */
    const typefaceMap = {
      system: { body: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif', heading: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif' },
      inter: { body: "'Inter', sans-serif", heading: "'Inter', sans-serif" },
      playfair: { body: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif', heading: "'Playfair Display', serif" },
      dmsans: { body: "'DM Sans', sans-serif", heading: "'DM Sans', sans-serif" },
      spacegrotesk: { body: "'Space Grotesk', sans-serif", heading: "'Space Grotesk', sans-serif" },
      lora: { body: "'Lora', serif", heading: "'Lora', serif" },
      montserrat: { body: "'Montserrat', sans-serif", heading: "'Montserrat', sans-serif" },
      merriweather: { body: "'Merriweather', serif", heading: "'Merriweather', serif" },
      roboto_slab: { body: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif', heading: "'Roboto Slab', serif" },
      worksans: { body: "'Work Sans', sans-serif", heading: "'Work Sans', sans-serif" }
    };

    const select = document.getElementById('typefaceSelect');
    const heading = document.getElementById('previewHeading');
    const body = document.getElementById('previewBody');

    /* Theme preview elements that update with typeface */
    const tpHeadingEls = [
      document.getElementById('tpLogo'),
      document.getElementById('tpNavLinks'),
      document.getElementById('tpHeroHeading'),
      document.getElementById('tpCardTitle1')
    ];
    const tpBodyEls = [
      document.getElementById('tpHeroSub'),
      document.getElementById('tpHeroDesc'),
      document.getElementById('tpCardDate1')
    ];

    function updatePreview() {
      const tf = typefaceMap[select.value];
      if (tf) {
        heading.style.fontFamily = tf.heading;
        body.style.fontFamily = tf.body;
        tpHeadingEls.forEach(el => { if (el) el.style.fontFamily = tf.heading; });
        tpBodyEls.forEach(el => { if (el) el.style.fontFamily = tf.body; });
      }
    }

    select.addEventListener('change', updatePreview);
    updatePreview();
  </script>
</body>
</html>
