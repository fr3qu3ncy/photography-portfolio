<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Migrations — <%= siteName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <nav class="admin-nav">
    <div class="nav-brand">
      <a href="/"><%= siteName %></a>
      <span class="nav-sep">/</span>
      <span>Admin</span>
    </div>
    <div class="nav-links">
      <a href="/admin">Albums</a>
      <a href="/admin/settings">Settings</a>
      <a href="/admin/migrations" class="active">Migrations</a>
      <a href="/">View Site</a>
      <a href="/admin/logout">Logout</a>
    </div>
  </nav>

  <main class="admin-main">
    <h1>Data Migrations</h1>
    <p class="admin-description">
      Migrations apply data transformations needed for version upgrades.
      Each migration runs exactly once and is recorded in <code>data/migrations.json</code>.
    </p>

    <% if (migrations.length === 0) { %>
      <div class="migration-card migration-empty">
        <p>No migrations registered.</p>
      </div>
    <% } else { %>
      <% migrations.forEach(m => { %>
        <div class="migration-card <%= m.completed ? 'migration-completed' : 'migration-pending' %>">
          <div class="migration-header">
            <div class="migration-status">
              <% if (m.completed) { %>
                <span class="status-dot completed"></span>
                <span>Completed</span>
              <% } else { %>
                <span class="status-dot pending"></span>
                <span>Pending</span>
              <% } %>
            </div>
            <h2 class="migration-title"><%= m.name %></h2>
          </div>
          <p class="migration-desc"><%= m.description %></p>
          <div class="migration-id">ID: <code><%= m.id %></code></div>

          <% if (!m.completed) { %>
            <form method="POST" action="/admin/migrations/<%= m.id %>/run" class="migration-run-form">
              <button type="submit" class="btn btn-primary"
                      onclick="return confirm('Run migration &quot;<%= m.name %>&quot;? This cannot be undone.')">
                Run Migration
              </button>
            </form>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <div class="migration-info">
      <h3>How migrations work</h3>
      <ul>
        <li>Each migration has a unique ID and runs exactly once</li>
        <li>Completed migrations are tracked in <code>data/migrations.json</code></li>
        <li>New migrations appear as "Pending" until you run them</li>
        <li>Migrations are safe to skip — they're optional data transformations</li>
        <li>Check server logs for migration progress details</li>
      </ul>
    </div>
  </main>

  <style>
    .migration-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 1rem;
    }
    .migration-card.migration-completed {
      border-left: 3px solid #10b981;
    }
    .migration-card.migration-pending {
      border-left: 3px solid #f59e0b;
    }
    .migration-card.migration-empty {
      border-left: 3px solid var(--border);
      opacity: 0.6;
    }
    .migration-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.75rem;
    }
    .migration-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin: 0;
    }
    .migration-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      color: var(--text-muted);
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }
    .status-dot.completed { background: #10b981; }
    .status-dot.pending { background: #f59e0b; }
    .migration-desc {
      color: var(--text-muted);
      margin: 0.5rem 0;
      line-height: 1.5;
    }
    .migration-id {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }
    .migration-id code {
      background: var(--bg);
      padding: 0.125rem 0.375rem;
      border-radius: 4px;
    }
    .migration-run-form { margin-top: 0.5rem; }
    .migration-info {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-top: 1.5rem;
    }
    .migration-info h3 { margin-top: 0; }
    .migration-info ul {
      color: var(--text-muted);
      line-height: 1.8;
    }
    .migration-info code {
      background: var(--bg);
      padding: 0.125rem 0.375rem;
      border-radius: 4px;
      font-size: 0.875rem;
    }
  </style>
</body>
</html>
