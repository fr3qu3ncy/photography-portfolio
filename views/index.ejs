<!DOCTYPE html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= siteName %></title>
  <% if (metaDescription) { %><meta name="description" content="<%= metaDescription %>"><% } %>

  <!-- Favicons -->
  <% if (typeof faviconFilename !== 'undefined' && faviconFilename) { %><link rel="icon" type="image/png" sizes="32x32" href="/uploads/<%= faviconFilename %>"><% } %>
  <% if (typeof appleTouchIconFilename !== 'undefined' && appleTouchIconFilename) { %><link rel="apple-touch-icon" sizes="180x180" href="/uploads/<%= appleTouchIconFilename %>"><% } %>

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= ogUrl %>">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= siteName %>">
  <% if (metaDescription) { %><meta property="og:description" content="<%= metaDescription %>"><% } %>
  <meta property="og:url" content="<%= ogUrl %>">
  <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= siteName %>">
  <% if (metaDescription) { %><meta name="twitter:description" content="<%= metaDescription %>"><% } %>
  <% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link rel="stylesheet" href="/css/style.css">
  <%- include('./partials/fonts') %>

  <!-- Structured Data: Organization + WebPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "<%= ogUrl %>/#organization",
        "name": "<%= siteName %>",
        "url": "<%= ogUrl %>"
        <% if (ogImage) { %>,
        "logo": {
          "@type": "ImageObject",
          "url": "<%= ogImage %>"
        }<% } %>
      },
      {
        "@type": "WebPage",
        "@id": "<%= ogUrl %>/#webpage",
        "url": "<%= ogUrl %>",
        "name": "<%= siteName %>",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "<%= ogUrl %>/#website",
          "url": "<%= ogUrl %>",
          "name": "<%= siteName %>",
          "publisher": {
            "@id": "<%= ogUrl %>/#organization"
          }
        }
        <% if (metaDescription) { %>,
        "description": "<%= metaDescription.replace(/"/g, '\\"') %>"<% } %>
      }
    ]
  }
  </script>
</head>
<body>
  <nav class="site-nav">
    <a href="/" class="site-logo">
      <% if (logo) { %><img src="/uploads/<%= logo %>" alt="<%= siteName %>" class="logo-img"><% } else { %><%= siteName %><% } %>
    </a>
    <div class="nav-links"><a href="/">Home</a></div>
  </nav>
  <main class="container">
    <div class="page-header" style="text-align: <%= headingAlignment || 'center' %>;">
      <h1 class="page-title"><%= heading %></h1>
      <% if (subheading) { %><p class="page-subtitle"><%= subheading %></p><% } %>
      <% if (description) { %><p class="page-description"><%= description %></p><% } %>
    </div>
    <section class="albums-grid">
      <% if (albums.length === 0) { %>
        <p class="empty-state">No albums yet.</p>
      <% } else { %>
        <% albums.forEach(album => { %>
          <% const titlePhoto = (album.photos || []).find(p => p.id === album.titlePhotoId); %>
          <a href="/album/<%= album.id %>" class="album-card">
            <div class="album-cover">
              <% if (titlePhoto) { %>
                <img src="/uploads/<%= titlePhoto.placeholderFilename || titlePhoto.thumbFilename %>"
                     data-src="/uploads/<%= titlePhoto.thumbFilename %>"
                     alt="<%= album.title %>"
                     <% if (titlePhoto.thumbWidth) { %>width="<%= titlePhoto.thumbWidth %>" height="<%= titlePhoto.thumbHeight %>"<% } %>
                     loading="lazy"
                     class="blur-up">
              <% } else { %>
                <div class="album-cover-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <path d="M21 15l-5-5L5 21"/>
                  </svg>
                </div>
              <% } %>
            </div>
            <div class="album-info">
              <h2 class="album-title"><%= album.title %></h2>
              <% if (album.subtitle) { %>
                <p class="album-subtitle"><%= album.subtitle %></p>
              <% } %>
              <% const d = new Date(album.date + 'T00:00:00'); const formatted = d.getFullYear() + ', ' + d.toLocaleDateString('en-GB', { month: 'long' }) + ' ' + d.getDate(); %>
              <span class="album-date"><%= formatted %></span>
            </div>
          </a>
        <% }) %>
      <% } %>
    </section>
  </main>
  <footer class="site-footer">
    <p>&copy; <%= new Date().getFullYear() %> <%= siteName %></p>
  </footer>
  <script>
    // ── Blur-up for album covers ──
    document.querySelectorAll('.blur-up').forEach(img => {
      const thumbSrc = img.dataset.src;
      if (!thumbSrc) return;
      img.addEventListener('load', () => img.classList.add('loaded'));
      img.src = thumbSrc;
    });

    document.querySelectorAll('a[href^="/album/"]').forEach(a => {
      a.addEventListener('click', () => sessionStorage.setItem('scrollPos', window.scrollY));
    });
    if (sessionStorage.getItem('scrollPos')) {
      window.scrollTo(0, +sessionStorage.getItem('scrollPos'));
      sessionStorage.removeItem('scrollPos');
    }
  </script>
</body>
</html>
