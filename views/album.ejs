<!DOCTYPE html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= album.title %> - <%= siteName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeface && typeface !== 'system') { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=<%= typeface === 'inter' ? 'Inter:wght@400;600;700' : typeface === 'playfair' ? 'Playfair+Display:wght@600;700' : typeface === 'dmsans' ? 'DM+Sans:ital,wght@0,400;0,600;0,700;1,400' : typeface === 'spacegrotesk' ? 'Space+Grotesk:wght@400;600;700' : 'Lora:wght@400;600;700' %>&display=swap" rel="stylesheet">
  <style>
    <% if (typeface === 'inter') { %>
      :root { --font-body: 'Inter', sans-serif; --font-heading: 'Inter', sans-serif; }
    <% } else if (typeface === 'playfair') { %>
      :root { --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; --font-heading: 'Playfair Display', serif; }
    <% } else if (typeface === 'dmsans') { %>
      :root { --font-body: 'DM Sans', sans-serif; --font-heading: 'DM Sans', sans-serif; }
    <% } else if (typeface === 'spacegrotesk') { %>
      :root { --font-body: 'Space Grotesk', sans-serif; --font-heading: 'Space Grotesk', sans-serif; }
    <% } else if (typeface === 'lora') { %>
      :root { --font-body: 'Lora', serif; --font-heading: 'Lora', serif; }
    <% } %>
  </style>
  <% } %>
</head>
<body>
  <nav class="site-nav">
    <a href="/" class="site-logo">
      <% if (logo) { %><img src="/uploads/<%= logo %>" alt="<%= siteName %>" class="logo-img"><% } else { %><%= siteName %><% } %>
    </a>
    <div class="nav-links"><a href="/">Home</a></div>
  </nav>
  <main class="container">
    <div class="album-header">
      <a href="/" class="back-link">&larr; All Albums</a>
      <h1 class="album-page-title"><%= album.title %></h1>
      <% if (album.subtitle) { %>
        <p class="album-page-subtitle"><%= album.subtitle %></p>
      <% } %>
      <% const d = new Date(album.date + 'T00:00:00'); const formatted = d.getFullYear() + ', ' + d.toLocaleDateString('en-GB', { month: 'long' }) + ' ' + d.getDate(); %>
      <span class="album-page-date"><%= formatted %></span>
      <% if (album.description) { %>
        <p class="album-page-description"><%= album.description %></p>
      <% } %>
    </div>

    <section class="photo-gallery">
      <% photos.forEach(photo => { %>
        <div class="gallery-item">
          <img src="/uploads/<%= photo.thumbFilename %>"
               data-full="/uploads/<%= photo.fullFilename %>"
               alt="<%= album.title %>"
               loading="lazy"
               class="gallery-img">
        </div>
      <% }) %>
    </section>

    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true">
      <button class="lightbox-close" aria-label="Close">&times;</button>
      <button class="lightbox-prev" aria-label="Previous">&#8249;</button>
      <button class="lightbox-next" aria-label="Next">&#8250;</button>
      <div class="lightbox-content">
        <img src="" alt="">
      </div>
    </div>
  </main>
  <footer class="site-footer">
    <p>&copy; <%= new Date().getFullYear() %> <%= siteName %></p>
  </footer>
  <script src="/js/lightbox.js"></script>
</body>
</html>
