<!DOCTYPE html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= album.title %> - <%= siteName %></title>
  <% if (metaDescription) { %><meta name="description" content="<%= metaDescription %>"><% } %>

  <!-- Favicons -->
  <% if (typeof faviconFilename !== 'undefined' && faviconFilename) { %><link rel="icon" type="image/png" sizes="32x32" href="/uploads/<%= faviconFilename %>"><% } %>
  <% if (typeof appleTouchIconFilename !== 'undefined' && appleTouchIconFilename) { %><link rel="apple-touch-icon" sizes="180x180" href="/uploads/<%= appleTouchIconFilename %>"><% } %>

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= ogUrl %>">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= album.title %> - <%= siteName %>">
  <% if (metaDescription) { %><meta property="og:description" content="<%= metaDescription %>"><% } %>
  <meta property="og:url" content="<%= ogUrl %>">
  <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= album.title %> - <%= siteName %>">
  <% if (metaDescription) { %><meta name="twitter:description" content="<%= metaDescription %>"><% } %>
  <% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link rel="stylesheet" href="/css/style.css">
  <%- include('./partials/fonts') %>

  <!-- Structured Data: ImageGallery -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "@id": "<%= ogUrl %>/#gallery",
    "url": "<%= ogUrl %>",
    "name": "<%= album.title %>",
    "description": "<%= (album.description || metaDescription || album.subtitle || '').replace(/"/g, '\\"').slice(0, 500) %>",
    "partOf": {
      "@type": "WebPage",
      "@id": "<%= ogUrl %>/#webpage",
      "url": "<%= ogUrl %>",
      "name": "<%= album.title %> - <%= siteName %>"
    },
    "thumbnailUrl": "<%= ogImage %>",
    "image": [
      <% photos.slice(0, 20).forEach((photo, i) => { %>
        {
          "@type": "ImageObject",
          "contentUrl": "<%= siteUrl %>/uploads/<%= photo.fullFilename %>",
          "thumbnailUrl": "<%= siteUrl %>/uploads/<%= photo.thumbFilename %>",
          "name": "<%= album.title %> - Photo <%= i + 1 %>"
        }<% if (i < Math.min(photos.length, 20) - 1) { %>,<% } %>
      <% }) %>
    ]
  }
  </script>
</head>
<body class="album-page">
  <nav class="site-nav">
    <a href="/" class="site-logo">
      <% if (logo) { %><img src="/uploads/<%= logo %>" alt="<%= siteName %>" class="logo-img"><% } else { %><%= siteName %><% } %>
    </a>
    <div class="nav-links"><a href="/">Home</a></div>
  </nav>
  <main class="container">
    <div class="album-header">
      <a href="/" class="back-link" id="backToAlbums">&larr; All Albums</a>
      <h1 class="album-page-title"><%= album.title %></h1>
      <% if (album.subtitle) { %>
        <p class="album-page-subtitle"><%= album.subtitle %></p>
      <% } %>
      <% const d = new Date(album.date + 'T00:00:00'); const formatted = d.getFullYear() + ', ' + d.toLocaleDateString('en-GB', { month: 'long' }) + ' ' + d.getDate(); %>
      <span class="album-page-date"><%= formatted %></span>
      <% if (album.description) { %>
        <p class="album-page-description"><%= album.description %></p>
      <% } %>
    </div>

    <section class="photo-gallery">
      <% photos.forEach(photo => { %>
        <div class="gallery-item">
          <img src="/uploads/<%= photo.placeholderFilename || photo.thumbFilename %>"
               data-src="/uploads/<%= photo.thumbFilename %>"
               data-full="/uploads/<%= photo.fullFilename %>"
               alt="<%= album.title %>"
               loading="lazy"
               class="gallery-img blur-up">
        </div>
      <% }) %>
    </section>

    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true">
      <button class="lightbox-close" aria-label="Close">&times;</button>
      <button class="lightbox-prev" aria-label="Previous">&#8249;</button>
      <button class="lightbox-next" aria-label="Next">&#8250;</button>
      <div class="lightbox-content">
        <img src="" alt="">
      </div>
    </div>
  </main>
  <div class="album-footer">
    <a href="/" class="back-link back-link-bottom">&larr; All Albums</a>
  </div>
  <footer class="site-footer">
    <p>&copy; <%= new Date().getFullYear() %> <%= siteName %></p>
  </footer>
  <script src="/js/lightbox.js"></script>
</body>
</html>
