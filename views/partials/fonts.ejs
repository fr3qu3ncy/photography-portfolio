<% if (typeface && typeface !== 'system') { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%
    const fonts = {
      inter: 'Inter:wght@400;600;700',
      playfair: 'Playfair+Display:wght@600;700',
      dmsans: 'DM+Sans:ital,wght@0,400;0,600;0,700;1,400',
      spacegrotesk: 'Space+Grotesk:wght@400;600;700',
      lora: 'Lora:wght@400;600;700',
      montserrat: 'Montserrat:wght@400;600;700',
      merriweather: 'Merriweather:wght@400;700',
      roboto_slab: 'Roboto+Slab:wght@400;600;700',
      worksans: 'Work+Sans:wght@400;600;700'
    };
    const fontMap = {
      inter: { body: "'Inter', sans-serif", heading: "'Inter', sans-serif" },
      playfair: { body: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", heading: "'Playfair Display', serif" },
      dmsans: { body: "'DM Sans', sans-serif", heading: "'DM Sans', sans-serif" },
      spacegrotesk: { body: "'Space Grotesk', sans-serif", heading: "'Space Grotesk', sans-serif" },
      lora: { body: "'Lora', serif", heading: "'Lora', serif" },
      montserrat: { body: "'Montserrat', sans-serif", heading: "'Montserrat', sans-serif" },
      merriweather: { body: "'Merriweather', serif", heading: "'Merriweather', serif" },
      roboto_slab: { body: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", heading: "'Roboto Slab', serif" },
      worksans: { body: "'Work Sans', sans-serif", heading: "'Work Sans', sans-serif" }
    };
    const f = fonts[typeface];
    const m = fontMap[typeface];
  %>
  <!-- Non-blocking font load: preload as print, activate on load -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=<%= f %>&display=optional">
  <link id="google-font" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=<%= f %>&display=optional" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=<%= f %>&display=swap"></noscript>
  <style>
    :root { --font-body: <%- m.body %>; --font-heading: <%- m.heading %>; }
  </style>
<% } %>
